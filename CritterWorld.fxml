<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CritterWorldController">

    <Canvas fx:id="worldCanvas" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

    <HBox alignment="CENTER" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" mouseTransparent="true">
        <Label styleClass="title-badge" text="CRITTER WORLD!" />
    </HBox>

    <VBox fx:id="detailsPanel" layoutX="20.0" layoutY="100.0" prefWidth="320.0" styleClass="floating-panel" onMousePressed="#handlePanelMousePressed" onMouseDragged="#handlePanelMouseDragged">
        <HBox alignment="TOP_RIGHT">
            <Button text="x" styleClass="close-btn" onAction="#closeDetailsPanel"/>
        </HBox>
        <Label styleClass="panel-title" text="CRITTER DETAILS:" />
        
        <Label styleClass="section-label" text="MEMORY:" />
        <TextField fx:id="memoryField" editable="false" text="[10, 1, 1, 6, 6, 1, 0, 0, 5, 0]" styleClass="mono-field"/>
        
        <Label styleClass="section-label" text="LAST EXECUTED RULE:" />
        <TextArea fx:id="lastRuleArea" editable="false" wrapText="true" prefHeight="80.0" styleClass="mono-area"/>
        
        <Label styleClass="section-label" text="PROGRAM:" />
        <TextArea fx:id="programArea" editable="false" wrapText="true" prefHeight="200.0" styleClass="mono-area"/>
    </VBox>

    <VBox fx:id="statsPanel" layoutX="850.0" layoutY="20.0" prefWidth="250.0" styleClass="floating-panel" onMousePressed="#handlePanelMousePressed" onMouseDragged="#handlePanelMouseDragged">
        <Label fx:id="timeStepsLabel" text="TIME STEPS: 0" styleClass="stat-label"/>
        <Label fx:id="aliveCrittersLabel" text="ALIVE CRITTERS: 0" styleClass="stat-label"/>
        <Label fx:id="fpsLabel" text="FRAMES/SEC: 0.0" styleClass="stat-label"/>
        <Label fx:id="spsLabel" text="STEPS/SEC: 0.0" styleClass="stat-label"/>
        
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
            <Button text="-" onAction="#decreaseSpeed" styleClass="circle-btn"/>
            <VBox alignment="CENTER">
                <Label text="SPEED" styleClass="speed-label"/>
                <Label fx:id="speedValueLabel" text="1.00x" styleClass="speed-value"/>
            </VBox>
            <Button text="+" onAction="#increaseSpeed" styleClass="circle-btn"/>
        </HBox>
    </VBox>

    <VBox fx:id="controlsPanel" layoutX="850.0" layoutY="450.0" prefWidth="250.0" spacing="10" styleClass="floating-panel" onMousePressed="#handlePanelMousePressed" onMouseDragged="#handlePanelMouseDragged">
        <Button text="NEW WORLD" maxWidth="Infinity" onAction="#handleNewWorld"/>
        <Button text="LOAD WORLD" maxWidth="Infinity" onAction="#handleLoadWorld"/>
        
        <HBox spacing="5" alignment="CENTER">
            <Label text="LOAD"/>
            <TextField fx:id="loadAmountField" text="5" prefWidth="40" alignment="CENTER"/>
            <Label text="CRITTERS"/>
        </HBox>
        
        <Button text="CREATE/LOAD" maxWidth="Infinity" onAction="#handleCreateLoadCritter"/>
        
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
            <Button text="URL" onAction="#handleUrlLoad" styleClass="square-btn"/>
            <Button fx:id="playPauseBtn" text="▶" onAction="#togglePlay" styleClass="square-btn"/>
            <Button text="1 STEP" onAction="#stepOnce" styleClass="square-btn"/>
        </HBox>
        
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
             <Button text="-" onAction="#zoomOut" styleClass="circle-btn"/>
             <VBox alignment="CENTER">
                <Label text="ZOOM" styleClass="speed-label"/>
                <Label fx:id="zoomValueLabel" text="100%" styleClass="speed-value"/>
            </VBox>
             <Button text="+" onAction="#zoomIn" styleClass="circle-btn"/>
        </HBox>
    </VBox>

    <Button text="?" styleClass="circle-btn, help-btn" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" onAction="#showHelp"/>

</AnchorPane>